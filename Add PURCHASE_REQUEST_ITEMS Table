CREATE TABLE PURCHASE_REQUEST_ITEMS (
    PR_ITEM_ID NUMBER PRIMARY KEY,
    PR_ID NUMBER,
    PRODUCT_ID NUMBER,
    QUANTITY NUMBER,
    UNIT_PRICE NUMBER(10,2),
    CONSTRAINT FK_PRI_PR
        FOREIGN KEY (PR_ID)
        REFERENCES PURCHASE_REQUEST(PR_ID),
    CONSTRAINT FK_PRI_PRODUCT
        FOREIGN KEY (PRODUCT_ID)
        REFERENCES PRODUCTS(PRODUCT_ID)
);
